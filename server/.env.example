# Discover Cairo Server Environment Configuration
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to version control.

# Server Runtime
PORT=4000
NODE_ENV=development

# Database Connection
# Use your MongoDB Atlas connection string (or local mongodb URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Authentication
# Must be at least 32 characters in length
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# CORS Whitelist (client origin URL)
CLIENT_ORIGIN=http://localhost:5173

# Demo Controls (simulated actions: false by default, never true in production)
ENABLE_DEMO_ACTIONS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
